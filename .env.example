# Nomes das environment variables da rotina — SEM VALORES.
# Os valores reais vão nas environment variables do ambiente de nuvem
# (Claude Routines). Nunca commitar um .env preenchido.

# INLABS (Imprensa Nacional — download do DOU em XML; cadastro gratuito)
INLABS_LOGIN=
INLABS_SENHA=

# Evolution API (servidor próprio de WhatsApp)
EVOLUTION_API_URL=       # ex.: https://evo.seudominio.com (sem barra final)
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=      # nome da instância criada no servidor

# Destino das mensagens de LEADS — a cliente (formato internacional, só
# dígitos: 55 + DDD + número)
WHATSAPP_DESTINO=

# Destino dos ALERTAS TÉCNICOS — o operador da automação (mesmo formato).
# OPCIONAL, mas sem ele os alertas (push falhou, fonte bloqueada) são só
# registrados no log da run; eles NUNCA vão para WHATSAPP_DESTINO.
WHATSAPP_ADMIN=

# Portal da Transparência — enriquecimento CEIS/CNEP (CNPJ, link do registro de
# sanção, histórico da empresa). OPCIONAL: sem a chave a rotina roda igual, só
# entrega o lead sem esses campos. Chave gratuita por e-mail em
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_TOKEN=

# Relays das fontes (OPCIONAIS — necessários na nuvem). O ambiente do Claude
# não alcança os sites governamentais (docs/ISSUES.md §1); com estas variáveis
# os coletores baixam via relay no VPS (docs/CONFIGURACAO.md §4.6) e os links
# entregues à cliente continuam apontando para os sites oficiais. Vazias = modo
# local, falando direto com cada site. Sem barra final.
DODF_BASE_URL=        # ex.: https://relay.seudominio.host        (DODF)
INLABS_BASE_URL=      # ex.: https://relay.seudominio.host/inlabs (DOU em XML)
IN_GOV_BASE_URL=      # ex.: https://relay.seudominio.host/ingov  (link da matéria)

# Fuso horário (não é segredo). A VM da nuvem roda em UTC; sem isso os scripts
# podem calcular a data errada dependendo do horário do agendamento.
TZ=America/Sao_Paulo
