# Nomes das environment variables da rotina — SEM VALORES.
# Os valores reais vão nas environment variables do ambiente de nuvem
# (Claude Routines). Nunca commitar um .env preenchido.

# INLABS (Imprensa Nacional — download do DOU em XML; cadastro gratuito)
INLABS_LOGIN=
INLABS_SENHA=

# Evolution API (servidor próprio de WhatsApp)
EVOLUTION_API_URL=       # ex.: https://evo.seudominio.com (sem barra final)
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=      # nome da instância criada no servidor

# Destino das mensagens (formato internacional, só dígitos: 55 + DDD + número)
WHATSAPP_DESTINO=

# Fuso horário (não é segredo). A VM da nuvem roda em UTC; sem isso os scripts
# podem calcular a data errada dependendo do horário do agendamento.
TZ=America/Sao_Paulo
